NODE_ENV=development
PORT=4000
APP_NAME=Kadi
APP_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
# Set an exact proxy hop count/CIDR only after checking the hosting network.
# Direct local requests: false. A single mandatory trusted proxy: 1.
TRUST_PROXY=false
JSON_BODY_LIMIT=2mb
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
SUPABASE_ANON_KEY=replace-with-public-anon-key
# MUST equal VITE_SUPABASE_LOGO_BUCKET. Existing KADI frontend uses this bucket name.
SUPABASE_LOGO_BUCKET=kadi-compnies-logo
EMAIL_REDIRECT_URL=http://localhost:5173/login?confirmed=1
PASSWORD_RESET_REDIRECT_URL=http://localhost:5173/reset-password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=Kadi
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_REQUEST_TIMEOUT_MS=15000
OPENAI_PROMPT_MAX_CHARS=4000
OPENAI_MAX_COMPLETION_TOKENS=4000
AUTH_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_MAX=12
PDF_RATE_LIMIT_MAX=30
